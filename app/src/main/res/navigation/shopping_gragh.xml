<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shopping_gragh"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.groovyshopping.ui.fragments.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>

    <action
        android:id="@+id/action_global_productDetailsFragment"
        app:destination="@id/productDetailsFragment" />

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.example.groovyshopping.ui.fragments.CartFragment"
        android:label="CartFragment"
        tools:layout="@layout/fragment_cart">
        <action
            android:id="@+id/action_cartFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
        <action
            android:id="@+id/action_cartFragment_to_billingFragment"
            app:destination="@id/billingFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.groovyshopping.ui.fragments.ProfileFragment"
        android:label="ProfileFragment"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_addressFragment"
            app:destination="@id/addressFragment" />

        <action
            android:id="@+id/action_profileFragment_to_userAccountFragment"
            app:destination="@id/userAccountFragment" />

        <action
            android:id="@+id/action_profileFragment_to_ordersFragment"
            app:destination="@id/ordersFragment" />

        <action
            android:id="@+id/action_profileFragment_to_billingFragment"
            app:destination="@id/billingFragment" />

        <action
            android:id="@+id/action_profileFragment_to_orderDetailFragment"
            app:destination="@id/orderDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.groovyshopping.ui.fragments.SearchFragment"
        android:label="SearchFragment"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/productDetailsFragment"
        android:name="com.example.groovyshopping.ui.fragments.ProductDetailsFragment"
        android:label="ProductDetailsFragment"
        tools:layout="@layout/fragment_product_details">

        <argument
            android:name="product"
            app:argType="com.example.groovyshopping.data.Product" />
    </fragment>

    <fragment
        android:id="@+id/addressFragment"
        android:name="com.example.groovyshopping.ui.fragments.AddressFragment"
        android:label="AddressFragment"
        tools:layout="@layout/fragment_address">
        <argument
            android:name="address"
            app:argType="com.example.groovyshopping.data.Address"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/billingFragment"
        android:name="com.example.groovyshopping.ui.fragments.BillingFragment"
        android:label="BillingFragment"
        tools:layout="@layout/fragment_billing">
        <action
            android:id="@+id/action_billingFragment_to_addressFragment"
            app:destination="@id/addressFragment" />
        <action
            android:id="@+id/action_billingFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
        <argument
            android:name="totalPrice"
            app:argType="float" />
        <argument
            android:name="products"
            app:argType="com.example.groovyshopping.data.CartProduct[]" />
        <argument
            android:name="payment"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/accessoryFragment"
        android:name="com.example.groovyshopping.ui.categories.AccessoryFragment"
        android:label="AccessoryFragment"
        tools:layout="@layout/fragment_accessory">
        <action
            android:id="@+id/action_accessoryFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/chairFragment"
        android:name="com.example.groovyshopping.ui.categories.ChairFragment"
        android:label="ChairFragment"
        tools:layout="@layout/fragment_chair">
        <action
            android:id="@+id/action_chairFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/cupboardFragment"
        android:name="com.example.groovyshopping.ui.categories.CupboardFragment"
        android:label="CupboardFragment"
        tools:layout="@layout/fragment_cupboard">
        <action
            android:id="@+id/action_cupboardFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/tableFragment"
        android:name="com.example.groovyshopping.ui.categories.TableFragment"
        android:label="TableFragment"
        tools:layout="@layout/fragment_table">
        <action
            android:id="@+id/action_tableFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/ordersFragment"
        android:name="com.example.groovyshopping.ui.fragments.OrdersFragment"
        android:label="OrdersFragment"
        tools:layout="@layout/fragment_orders">

        <action
            android:id="@+id/action_ordersFragment_to_orderDetailFragment"
            app:destination="@id/orderDetailFragment" />
    </fragment>

    <!-- Order Detail Fragment -->
    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.example.groovyshopping.ui.fragments.OrderDetailFragment"
        android:label="OrderDetailFragment"
        tools:layout="@layout/fragment_order_detail">

        <argument
            android:name="order"
            app:argType="com.example.groovyshopping.data.order.Order" />
    </fragment>

    <fragment
        android:id="@+id/userAccountFragment"
        android:name="com.example.groovyshopping.ui.fragments.UserAccountFragment"
        android:label="UserAccountFragment"
        tools:layout="@layout/fragment_user_account" />

    <fragment
        android:id="@+id/furnitureFragment"
        android:name="com.example.groovyshopping.ui.categories.FurnitureFragment"
        android:label="FurnitureFragment"
        tools:layout="@layout/fragment_furniture">
        <action
            android:id="@+id/action_furnitureFragment_to_productDetailsFragment"
            app:destination="@id/productDetailsFragment" />
    </fragment>

</navigation>